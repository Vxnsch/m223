<% content_for :title, "4RCHIVE | New archive page" %>

<h1>New archive page</h1>

<% @page.errors.full_messages.each do |message| %>
  <p><%= message %></p>
<% end %>

<%= form_with model: @page do |form| %>
  <div>
    <%= form.label :title, "Clothing item name" %>
    <%= form.text_field :title, required: true %>
  </div>

  <%= form.fields_for :content_items do |content_form| %>
    <%= content_form.hidden_field :content_type, value: "description" %>

    <div>
      <%= content_form.label :text, "Description" %>
      <%= content_form.text_area :text %>
    </div>

    <div>
      <%= content_form.label :datetime, "Release date" %>
      <%= content_form.date_field :datetime %>
    </div>

    <div>
      <%= content_form.label :url, "Source or shop URL" %>
      <%= content_form.url_field :url %>
    </div>
  <% end %>

  <div>
    <%= form.label :image %>
    <%= form.file_field :image, accept: "image/*" %>
  </div>

  <%= form.submit "Create archive page" %>
<% end %>

<%= link_to "Back to archive", pages_path %>
