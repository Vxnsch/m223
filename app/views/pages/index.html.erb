<% content_for :title, "4RCHIVE | Archive" %>

<h1>Archive</h1>

<% if policy(Page).create? %>
  <p><%= link_to "Create archive page", new_page_path %></p>
<% end %>

<%= form_with url: pages_path, method: :get do |form| %>
  <%= form.label :query, "Search clothing" %>
  <%= form.search_field :query, value: params[:query] %>
  <%= form.submit "Search" %>
<% end %>

<ul>
  <% @pages.each do |page| %>
    <li><%= link_to page.title, page_path(page) %></li>
  <% end %>
</ul>