<h1 class="login-title">Login</h1>

<%= form_with url: login_path do |form| %>
    <div>
        <%= form.label :email %>
        <%= form.email_field :email %>
    </div>

    <div>
        <%= form.label :password %>
        <%= form.password_field :password %>
    </div>

    <%= form.submit "Log in" %>
<% end %>
<p>
    New?
    <%= link_to "Create Account", new_user_path %>
    instead
</p> 